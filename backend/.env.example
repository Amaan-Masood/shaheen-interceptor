# ============================================================================
# Shaheen Interceptor - Environment Configuration
# ============================================================================

# Google Gemini API Key (Official Google GenAI SDK)
# If provided, enables live Gemini 2.5 Flash inference.
# If omitted or offline, automatic deterministic forensic fallback activates.
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Platform Project Configuration
GOOGLE_CLOUD_PROJECT=shaheen-interceptor
GCP_PROJECT=shaheen-interceptor

# Google Cloud Service Account Key (Optional for local Firestore connection)
# Leave empty to use Application Default Credentials (ADC) on Google Cloud Run
# or when running in local in-memory persistence mode.
GOOGLE_APPLICATION_CREDENTIALS=

# Server Configuration
PORT=8080
HOST=0.0.0.0
